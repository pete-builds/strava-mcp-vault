# Strava API credentials (from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=your-client-id
STRAVA_CLIENT_SECRET=your-client-secret

# Initial tokens from OAuth flow (see README)
# After first boot, tokens are managed automatically in SQLite
STRAVA_ACCESS_TOKEN=your-initial-access-token
STRAVA_REFRESH_TOKEN=your-initial-refresh-token

# Optional: change the server port (default: 18201)
# STRAVA_MCP_PORT=18201

# Optional: bind to a specific IP (default: 127.0.0.1, localhost only)
# Set to a Tailscale/LAN IP for remote access, or 0.0.0.0 for all interfaces.
# MCP_BIND_HOST=100.x.x.x

# Bearer token for MCP endpoint authentication.
# Required unless MCP_ALLOW_UNAUTHENTICATED=1 is set. The server refuses
# to start without one of these — the endpoint exposes private Strava data.
# MCP_AUTH_TOKEN=your-secret-token

# Set to 1 to opt out of authentication. Only safe when the port is bound
# to localhost or a trusted network (e.g. Tailscale).
# MCP_ALLOW_UNAUTHENTICATED=1

# Optional: Origin allowlist (DNS-rebinding protection for browser clients).
# Comma-separated list of exact origin strings (scheme + host + optional port).
# Requests with no Origin header (curl, MCP desktop clients) are always allowed.
# MCP_ALLOWED_ORIGINS=http://localhost:18201,https://claude.ai

# Optional: Fernet key for encrypting tokens at rest in SQLite
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If not set, tokens are stored in plaintext (still protected by .env and file permissions)
# TOKEN_ENCRYPTION_KEY=your-fernet-key
